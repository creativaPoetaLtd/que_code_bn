{
  "watch": ["src", ".env"],
  "ext": "ts,js,json",
  "ignore": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "node_modules/**/*",
    "dist/**/*",
    "*.log"
  ],
  "exec": "ts-node --require dotenv/config ./src/index.ts",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": "1000",
  "verbose": true,
  "restartable": "rs",
  "legacyWatch": false,
  "polling": false
}
