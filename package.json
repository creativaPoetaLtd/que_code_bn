{
  "name": "que_code_bn",
  "version": "1.0.1",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --ignore-watch node_modules --require dotenv/config src/index.ts",
    "dev:nodemon": "nodemon",
    "dev:clean": "pkill -f 'ts-node-dev' || true && pnpm run dev",
    "dev:verbose": "ts-node-dev --respawn --transpile-only --ignore-watch node_modules --require dotenv/config --poll --rs --clear src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs'), path=require('path'); const src='src/database/seeders', dst='dist/database/seeders'; fs.mkdirSync(dst,{recursive:true}); for (const file of fs.readdirSync(src).filter((name)=>name.endsWith('.js'))) fs.copyFileSync(path.join(src,file), path.join(dst,file));\"",
    "start": "node --require dotenv/config dist/index.js",
    "heroku-postbuild": "pnpm run build",
    "drop-all-tables": "psql -U your_username -d your_database_name -c \"SELECT 'DROP TABLE IF EXISTS \"' || tablename || '\" CASCADE;' FROM pg_tables WHERE schemaname = 'public'\" | psql -U your_username -d your_database_name",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:reset": "npx sequelize-cli db:migrate:undo:all && pnpm run migrate && pnpm run seed",
    "migrate:down": "npx sequelize-cli db:migrate:undo:all",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "migrate:undo:all": "npx sequelize-cli db:migrate:undo:all",
    "update-models": "npx sequelize-cli migration:generate --name update-models",
    "seed": "node --require dotenv/config dist/database/seeders/cli.js || ts-node --require dotenv/config src/database/seeders/cli.ts",
    "seed:undo": "node --require dotenv/config dist/database/seeders/cli.js undo || ts-node --require dotenv/config src/database/seeders/cli.ts undo",
    "lint": "eslint .",
    "beauty": "prettier . --write",
    "check": "prettier . --check",
    "prepare": "husky install",
    "precommit": "prettier . --write && eslint --fix .",
    "run-tests": "cross-env NODE_ENV=test jest --detectOpenHandles --coverage --verbose --testTimeout=10000",
    "test:e2ee": "ts-node --transpile-only scripts/e2ee-protocol-smoke.ts",
    "pretest": "cross-env NODE_ENV=test pnpm run migrate:reset",
    "run-after-tests": "cross-env NODE_ENV=test sequelize db:migrate:undo:all ",
    "test": "npm-run-all run-tests run-after-tests --continue-on-error"
  },
  "engines": {
    "node": "22.14.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.1",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.18.0",
    "@types/node-cron": "^3.0.11",
    "@types/node-rsa": "^1.1.4",
    "@types/nodemailer": "^6.4.16",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/qrcode": "^1.5.5",
    "@types/socket.io": "^3.0.1",
    "@types/validator": "^13.12.2",
    "husky": "^9.1.6",
    "nodemon": "^3.1.7",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@sequelize/postgres": "^7.0.0-alpha.43",
