{
  "name": "que_code_bn",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
		"dev": "ts-node-dev --require dotenv/config src/index.ts",
		"build": "tsc",
		"start": "node --require dotenv/config dist/index.js",
		"drop-all-tables": "psql -U your_username -d your_database_name -c \"SELECT 'DROP TABLE IF EXISTS \"' || tablename || '\" CASCADE;' FROM pg_tables WHERE schemaname = 'public'\" | psql -U your_username -d your_database_name",
		"migrate": "npx sequelize-cli db:migrate",
		"migrate:reset": "npx sequelize-cli db:migrate:undo:all && npm run migrate && npm run seed",
		"migrate:down": "npx sequelize-cli db:migrate:undo:all",
		"migrate:undo": "npx sequelize-cli db:migrate:undo",
		"seed": "npx sequelize-cli db:seed:all",
		"seed:undo": "npx sequelize-cli db:seed:undo:all",
		"lint": "eslint .",
		"beauty": "prettier . --write",
		"check": "prettier . --check",
		"prepare": "husky",
		"precommit": "prettier . --write && eslint --fix .",
		"run-tests": "cross-env NODE_ENV=test jest --detectOpenHandles --coverage --verbose --testTimeout=10000",
		"pretest": "cross-env NODE_ENV=test npm run migrate:reset",
		"run-after-tests": "cross-env NODE_ENV=test sequelize db:migrate:undo:all ",
		"test": "npm-run-all run-tests run-after-tests --continue-on-error"
	},
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.4",
    "@types/validator": "^13.12.2",
    "nodemon": "^3.1.7",
    "rimraf": "^6.0.1",
    "sequelize-cli": "^6.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@sequelize/postgres": "^7.0.0-alpha.43",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-session": "^1.18.1",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.4",
    "sequelize-typescript": "^2.1.6",
    "undici-types": "^6.19.8"
  },
  "description": ""
}
