import { Request, Response } from "express";
import { v4 as uuidv4 } from "uuid";
import { insert_function, read_function } from "../utils/db_methods";
import {
  ContactInvitationAttributes,
  ContactInvitationCreationAttributes,
  UserModelAttributes,
} from "../types/model";
import sendEmail from "../helpers/email";

// Helper type guard
function isSequelizeInstance(obj: any): obj is { get: (opts?: any) => any } {
  return obj && typeof obj.get === "function";
}

// Send a contact invitation
const send_invitation = async (req: Request, res: Response): Promise<void> => {
  try {
    const { inviteeEmail, message } = req.body;
    const inviterId = (req as any).user?.id; // Assuming auth middleware adds user

    if (!inviteeEmail) {
      res.status(400).json({ message: "Invitee email is required" });
      return;
    }

    if (!inviterId) {
      res.status(401).json({ message: "User not authenticated" });
      return;
    }

    // Find the invitee by email
    const invitee = await read_function<UserModelAttributes>(
      "User",
      "findOne",
      { where: { email: inviteeEmail } }
    );

    if (!invitee) {
      res.status(404).json({ message: "User with this email not found" });
      return;
    }

    const inviteeData = isSequelizeInstance(invitee)
      ? invitee.get({ plain: true })
      : invitee;
    const inviteeId = inviteeData.id;

    if (inviterId === inviteeId) {
      res.status(400).json({ message: "You cannot invite yourself" });
      return;
    }

    // Check if invitation already exists
    const existingInvitation = await read_function<ContactInvitationAttributes>(
      "ContactInvitation",
      "findOne",
      {
        where: {
          inviterId,
          inviteeId,
          status: "pending",
        },
      }
    );

    if (existingInvitation) {
      res.status(400).json({ message: "Invitation already sent to this user" });
      return;
    }

    // Check if they are already contacts
    const existingContact = await read_function<any>("Contact", "findOne", {
      where: {
        $or: [
          { userAId: inviterId, userBId: inviteeId },
          { userAId: inviteeId, userBId: inviterId },
        ],
      },
    });

    if (existingContact) {
      res
        .status(400)
        .json({ message: "You are already connected with this user" });
      return;
    }

    // Get inviter details for email
    const inviter = await read_function<UserModelAttributes>(
      "User",
      "findOne",
      { where: { id: inviterId } }
    );

    if (!inviter) {
      res.status(404).json({ message: "Inviter not found" });
      return;
    }

    const inviterData = isSequelizeInstance(inviter)
      ? inviter.get({ plain: true })
      : inviter;

    // Create invitation
    const invitationToken = uuidv4();
    const expiresAt = new Date();
    expiresAt.setDate(expiresAt.getDate() + 7); // Expires in 7 days

    const invitationData: ContactInvitationCreationAttributes = {
      inviterId,
      inviteeId,
      status: "pending",
      invitationToken,
      invitedAt: new Date(),
      expiresAt,
    };

    const newInvitation = await insert_function<ContactInvitationAttributes>(
      "ContactInvitation",
      "create",
      invitationData
    );

    // Send invitation email
    try {
      await sendEmail({
        to: inviteeEmail,
        subject: "Contact Invitation",
        type: "contact_invitation",
        data: {
          inviterName: `${inviterData.firstName} ${inviterData.lastName}`,
          inviterEmail: inviterData.email,
          acceptUrl: `${process.env.FRONTEND_URL}/invitations/accept/${invitationToken}`,
          rejectUrl: `${process.env.FRONTEND_URL}/invitations/reject/${invitationToken}`,
          message: message || undefined,
        },
      });
    } catch (emailError) {
      console.error("Failed to send invitation email:", emailError);
      // Continue execution - the invitation was created even if email failed
    }

    const plainInvitation = isSequelizeInstance(newInvitation)
      ? newInvitation.get({ plain: true })
      : newInvitation;

    res.status(201).json({
      message: "Contact invitation sent successfully",
      data: plainInvitation,
    });
  } catch (error: any) {
    console.error("Invitation creation error:", error.message);
    res
      .status(500)
      .json({ message: "An error occurred while sending the invitation" });
  }
};

// Respond to a contact invitation
const respond_to_invitation = async (
  req: Request,
  res: Response
): Promise<void> => {
  try {
    const { id } = req.params;
    const { action } = req.body;
    const userId = (req as any).user?.id;

    if (!userId) {
      res.status(401).json({ message: "User not authenticated" });
      return;
    }

    if (!action || !["accept", "decline"].includes(action)) {
      res
        .status(400)
        .json({ message: "Valid action (accept or decline) is required" });
      return;
    }

    // Find the invitation
    const invitation = await read_function<ContactInvitationAttributes>(
      "ContactInvitation",
      "findOne",
      {
        where: {
          id,
          inviteeId: userId,
          status: "pending",
        },
      }
    );

    if (!invitation) {
      res
        .status(404)
        .json({ message: "Invitation not found or already responded" });
      return;
    }

    const invitationData = isSequelizeInstance(invitation)
      ? invitation.get({ plain: true })
      : invitation;

    // Check if invitation has expired
    if (
      invitationData.expiresAt &&
      new Date() > new Date(invitationData.expiresAt)
    ) {
      await insert_function<ContactInvitationAttributes>(
        "ContactInvitation",
        "update",
        { status: "expired" },
        { where: { id } }
      );
      res.status(400).json({ message: "Invitation has expired" });
      return;
    }

    const newStatus = action === "accept" ? "accepted" : "declined";

    // Update invitation status
    await insert_function<ContactInvitationAttributes>(
      "ContactInvitation",
      "update",
      {
        status: newStatus,
        respondedAt: new Date(),
      },
      { where: { id } }
    );

    // If accepted, create the contact relationship
    if (action === "accept") {
      const contactData = {
        userAId: invitationData.inviterId,
        userBId: invitationData.inviteeId,
        status: "active",
      };

      await insert_function<any>("Contact", "create", contactData);
    }

    // Get user details for notification email
    const inviter = await read_function<UserModelAttributes>(
      "User",
      "findOne",
      { where: { id: invitationData.inviterId } }
    );

    const invitee = await read_function<UserModelAttributes>(
      "User",
      "findOne",
      { where: { id: invitationData.inviteeId } }
    );

    if (inviter && invitee) {
      const inviterData = isSequelizeInstance(inviter)
        ? inviter.get({ plain: true })
        : inviter;
      const inviteeData = isSequelizeInstance(invitee)
        ? invitee.get({ plain: true })
        : invitee;

      try {
        await sendEmail({
          to: inviterData.email,
          subject: `Contact Invitation ${
            action === "accept" ? "Accepted" : "Declined"
          }`,
          type: "invitation_response",
          data: {
            inviteeName: `${inviteeData.firstName} ${inviteeData.lastName}`,
            inviteeEmail: inviteeData.email,
            action: action,
            accepted: action === "accept" ? "true" : "false",
          },
        });
      } catch (emailError) {
        console.error("Failed to send notification email:", emailError);
      }
    }

    res.status(200).json({
      message: `Invitation ${action}ed successfully`,
      contactCreated: action === "accept",
    });
  } catch (error: any) {
    console.error("Invitation response error:", error.message);
    res.status(500).json({
      message: "An error occurred while responding to the invitation",
    });
  }
};

// Get received invitations for current user
const get_received_invitations = async (
  req: Request,
  res: Response
): Promise<void> => {
  try {
    const userId = (req as any).user?.id;
    const { status } = req.query;

    if (!userId) {
      res.status(401).json({ message: "User not authenticated" });
      return;
    }

    const whereClause: any = { inviteeId: userId };
    if (status) {
      whereClause.status = status;
    }

    const invitations = await read_function<ContactInvitationAttributes[]>(
      "ContactInvitation",
      "findAll",
      {
        where: whereClause,
        order: [["invitedAt", "DESC"]],
      }
    );

    const plainInvitations = Array.isArray(invitations)
      ? invitations.map((i) =>
          isSequelizeInstance(i) ? i.get({ plain: true }) : i
        )
      : [];

    res.status(200).json(plainInvitations);
  } catch (error) {
    res
      .status(500)
      .json({ message: "An error occurred while fetching invitations" });
  }
};

// Get sent invitations for current user
const get_sent_invitations = async (
  req: Request,
  res: Response
): Promise<void> => {
  try {
    const userId = (req as any).user?.id;
    const { status } = req.query;

    if (!userId) {
      res.status(401).json({ message: "User not authenticated" });
      return;
    }

    const whereClause: any = { inviterId: userId };
    if (status) {
      whereClause.status = status;
    }

    const invitations = await read_function<ContactInvitationAttributes[]>(
      "ContactInvitation",
      "findAll",
      {
        where: whereClause,
        order: [["invitedAt", "DESC"]],
      }
    );

    const plainInvitations = Array.isArray(invitations)
      ? invitations.map((i) =>
          isSequelizeInstance(i) ? i.get({ plain: true }) : i
        )
      : [];

    res.status(200).json(plainInvitations);
  } catch (error) {
    res
      .status(500)
      .json({ message: "An error occurred while fetching invitations" });
  }
};

// Cancel a pending invitation
const cancel_invitation = async (
  req: Request,
  res: Response
): Promise<void> => {
  try {
    const { id } = req.params;
    const userId = (req as any).user?.id;

    if (!userId) {
      res.status(401).json({ message: "User not authenticated" });
      return;
    }

    const invitation = await read_function<ContactInvitationAttributes>(
      "ContactInvitation",
      "findOne",
      {
        where: {
          id,
          inviterId: userId,
          status: "pending",
        },
      }
    );

    if (!invitation) {
      res
        .status(404)
        .json({ message: "Invitation not found or cannot be cancelled" });
      return;
    }

    await read_function<ContactInvitationAttributes>(
      "ContactInvitation",
      "destroy",
      { where: { id } }
    );

    res.status(200).json({ message: "Invitation cancelled successfully" });
  } catch (error) {
    res
      .status(500)
      .json({ message: "An error occurred while cancelling the invitation" });
  }
};

export default {
  send_invitation,
  respond_to_invitation,
  get_received_invitations,
  get_sent_invitations,
  cancel_invitation,
};
