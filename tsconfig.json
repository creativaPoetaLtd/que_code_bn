{
	"compilerOptions": {
	  "jsx": "react",
	  "target": "es2016",
	  "module": "commonjs",
	  "rootDir": "./src",
	  "outDir": "./dist",
	  "resolveJsonModule": true,
	  "esModuleInterop": true,
	  "strict": true,
	  "forceConsistentCasingInFileNames": true,
	  "types": []
	},
	"exclude": ["node_modules", "**/*.test.ts", "**/*.spec.ts"]
  }
  